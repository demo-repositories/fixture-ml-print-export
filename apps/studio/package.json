{
  "dependencies": {
    "@sanity/blueprints": "^0.12.0",
    "@sanity/client": "^6.0.0",
    "@sanity/functions": "^1.2.0",
    "@sanity/image-url": "^1.1.0",
    "@sanity/vision": "6.14.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sanity": "6.14.1",
    "styled-components": "6.5.3"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "7.0.2",
    "vitest": "^3.0.0"
  },
  "name": "sanity-print-export",
  "private": true,
  "scripts": {
    "build": "tsc --noEmit && sanity build",
    "deploy:functions": "sanity blueprints deploy",
