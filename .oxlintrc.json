{
  "categories": {
    "correctness": "warn",
    "suspicious": "warn"
  },
  "ignorePatterns": [
    "**/.agents/**",
    "**/.cursor/**",
    "**/node_modules/**",
    "**/.next/**",
    "**/next-env.d.ts",
    "**/dist/**",
    "**/out/**",
    "**/.sanity/**",
    "**/sanity.types.ts"
  ],
  "plugins": [
    "typescript",
    "react"
  ],
  "rules": {
    "no-console": "off",
    "no-unused-vars": "warn",
    "react/exhaustive-deps": "warn",
    "react/react-in-jsx-scope": "off",
    "react/rules-of-hooks": "warn",
    "typescript/no-explicit-any": "warn"
  }
}
